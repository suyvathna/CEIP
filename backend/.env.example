# Copy to backend/.env and fill in real values.
# Settings() (app/core/config.py) requires all of these to start the app.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ceip
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ceip-evidence
MINIO_SECURE=false

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Engine A compliance scheduler -------------------------------------
# Optional: every value below has a default and an existing .env keeps
# working without them.
#
# Set SCHEDULER_ENABLED=false to drive the daily sweep from system cron,
# a Kubernetes CronJob or a cloud scheduler calling
# POST /compliance/tick instead. That endpoint is idempotent and takes
# the same Postgres advisory lock, so nothing else changes.
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Phnom_Penh

# Fires one sweep on application startup as well. Off by default - with
# rolling deploys it runs on every restart, which is harmless but noisy
# in the run ledger. Useful in development and after a long outage.
SCHEDULER_RUN_ON_STARTUP=false
